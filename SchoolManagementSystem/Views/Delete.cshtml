@model SchoolManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>

<h4>Are you sure you want to delete this student?</h4>
<div>
    <strong>Name:</strong> @Model.Name <br />
    <strong>Classroom:</strong> @Model.Classroom?.Name <br />
    <strong>Section:</strong> @Model.Section?.Name
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
